# SECURITY: Generate a strong random key for production
SECRET_KEY=change-me-in-production

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=soc_platform

# Elasticsearch (optional — ingestion degrades gracefully when down)
ELASTICSEARCH_HOSTS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# CORS — comma-separated origins allowed
CORS_ORIGINS=http://localhost:5173

# Used to build integration snippets/commands (default http://localhost:8000)
PUBLIC_BACKEND_URL=http://localhost:8000

# Threat intelligence (all optional; defaults shown)
# Local MaxMind GeoLite2-City.mmdb — see README "Threat Intelligence Enrichment"
GEOIP_DB_PATH=
# Known-malicious IP feed (plain IP list or CSV; abuse.ch feeds, no API key)
THREAT_FEED_URL=https://feodotracker.abuse.ch/downloads/ipblocklist.txt
THREAT_FEED_REFRESH_HOURS=6
