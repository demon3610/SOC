# Root environment reference for `docker compose up -d`.
# These mirror the defaults in docker-compose.yml — copy to a real .env
# only if you need to override them. The backend also reads its own
# variables from backend/.env (see backend/.env.example).

# SECURITY: Generate a strong random key for production
SECRET_KEY=soc_dev_secret_key_8f93a12b490c67e81d

# MongoDB
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=soc_platform

# Elasticsearch
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# CORS — comma-separated origins allowed
CORS_ORIGINS=http://localhost:5173

# Used to build integration snippets/commands
PUBLIC_BACKEND_URL=http://localhost:8000

# Local MaxMind GeoLite2-City.mmdb — place in backend/data/ to enable GeoIP
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# Known-malicious IP feed (plain IP list or CSV; abuse.ch feeds, no API key)
THREAT_FEED_URL=https://feodotracker.abuse.ch/downloads/ipblocklist.txt
THREAT_FEED_REFRESH_HOURS=6
